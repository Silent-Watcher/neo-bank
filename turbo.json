{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  // Strict env mode (the default) passes only declared variables to tasks.
  // These runtime-only variables must reach tasks without affecting cache
  // keys: CI/NO_COLOR/FORCE_COLOR adjust tool output, DOCKER_HOST and
  // DOCKER_CONTEXT drive Testcontainers in the test tasks. No task currently
  // hashes on a variable's value, so env/globalEnv stay empty by design.
  "globalPassThroughEnv": ["CI", "NO_COLOR", "FORCE_COLOR", "DOCKER_HOST", "DOCKER_CONTEXT"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    // Docker-backed tiers (Testcontainers) depend on external mutable state:
    // a cached pass would skip real container verification, so they never
    // cache (ADR-035).
    "test:e2e": {
      "cache": false
    },
    "test:redis": {
      "cache": false
    },
    "test:db": {
      "cache": false
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
