{
  "name": "neo-bank",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "oxfmt --write .",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test test:e2e",
    "test:e2e": "turbo test:e2e",
    "docker:dev": "docker compose --env-file .env.docker.dev -f compose.dev.yml up --build -d",
    "docker:dev:down": "docker compose --env-file .env.docker.dev -f compose.dev.yml down",
    "docker:prod": "docker compose --env-file .env.docker.prod -f compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose --env-file .env.docker.prod -f compose.prod.yml down",
    "clean": "turbo clean",
    "cm": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.15 <25",
    "pnpm": "12.10.1"
  },
  "packageManager": "pnpm@12.10.1"
}
