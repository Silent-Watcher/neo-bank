# Values for Compose variable interpolation (ports, credentials, service
# configuration). Copy to .env.docker and adjust; pass it explicitly:
#   docker compose --env-file .env.docker -f compose.dev.yml up --build
#
# This file configures Compose itself. Application-internal configuration
# (env vars injected into containers) comes from the apps' env files via
# `env_file` — see docs/docker.md.

# Host ports for the applications.
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=5173

# Host ports for PostgreSQL and Redis (development tools only; production
# does not expose them).
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL credentials (used by both environments).
POSTGRES_USER=neo_bank
POSTGRES_DB=neo_bank
# Required: no default is provided for the database password.
POSTGRES_PASSWORD=

# Redis password — required in both environments: the Compose Redis always
# runs with requirepass, and the API receives the same value automatically.
REDIS_PASSWORD=
