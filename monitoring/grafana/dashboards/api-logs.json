{
  "annotations": {
    "list": []
  },
  "description": "Starting point for investigating Neo Bank API logs collected by Alloy into Loki. Filter by environment and service, watch log volume by level, and inspect error lines. Explore queries live in Explore.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Log entries per level over time, for services with a structured level label (the API). Plain-text services (postgres, redis, frontends) have no level label and appear here under an empty legend entry.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({env=~\"$env\", service=~\"$service\"}[$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume by level",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Everything collected for the current selection. Use the log row expansion to inspect labels and JSON fields; use the filter buttons to drill into lines.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=~\"$env\", service=~\"$service\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "All logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Only API error and fatal lines, via the structured level label the Alloy pipeline extracts from pino JSON. Plain-text services (postgres, redis, frontends) have no level label — use the All logs panel and line filters for those.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=~\"$env\", service=~\"$service\", level=~\"error|fatal\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "API errors and fatals (structured level)",
      "type": "logs"
    }
  ],
