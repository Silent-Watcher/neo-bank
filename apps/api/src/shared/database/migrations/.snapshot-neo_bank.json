        {
          "name": "base_entity_id_positive",
          "expression": "id > 0",
          "definition": "check (id > 0)"
        },
        {
          "name": "enrollments_current_step_valid",
          "expression": "current_step in ('NATIONAL_CODE', 'FULL_NAME', 'BIRTH_DATE', 'REFERRAL_CODE', 'USERNAME', 'PASSWORD', 'OCCUPATION', 'VIDEO_VERIFICATION', 'COMPLETED')",
          "definition": "check (current_step in ('NATIONAL_CODE', 'FULL_NAME', 'BIRTH_DATE', 'REFERRAL_CODE', 'USERNAME', 'PASSWORD', 'OCCUPATION', 'VIDEO_VERIFICATION', 'COMPLETED'))"
        },
        {
