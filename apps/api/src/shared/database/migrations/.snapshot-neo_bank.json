          "expression": "char_length(first_name) <= 50",
          "definition": "check (char_length(first_name) <= 50)"
        },
        {
          "name": "enrollments_last_name_length",
          "expression": "char_length(last_name) <= 50",
          "definition": "check (char_length(last_name) <= 50)"
        },
        {
          "name": "enrollments_national_code_format",
          "expression": "national_code ~ '^[0-9]{10}$'",
          "definition": "check (national_code ~ '^[0-9]{10}$')"
        },
        {
          "name": "enrollments_occupation_length",
          "expression": "char_length(occupation) <= 100",
          "definition": "check (char_length(occupation) <= 100)"
        },
        {
          "name": "enrollments_phone_number_format",
          "expression": "phone_number ~ '^09[0-9]{9}$'",
          "definition": "check (phone_number ~ '^09[0-9]{9}$')"
        },
        {
          "name": "enrollments_public_id_uuidv7",
          "expression": "uuid_extract_version(public_id) = 7",
          "definition": "check (uuid_extract_version(public_id) = 7)"
        },
        {
          "name": "enrollments_referral_code_length",
          "expression": "char_length(referral_code) <= 20",
          "definition": "check (char_length(referral_code) <= 20)"
        },
        {
          "name": "enrollments_status_valid",
          "expression": "status in ('INITIAL', 'IN_PROGRESS', 'PENDING_REVIEW', 'REJECTED', 'APPROVED', 'EXPIRED')",
          "definition": "check (status in ('INITIAL', 'IN_PROGRESS', 'PENDING_REVIEW', 'REJECTED', 'APPROVED', 'EXPIRED'))"
        },
        {
          "name": "enrollments_username_format",
          "expression": "username ~ '^[a-z0-9._-]{3,30}$'",
