# Dockerfile.prod-specific ignore (replaces the root .dockerignore, not
# merged). Excludes everything the API build does not need; the other apps
# keep only their manifests for turbo prune's workspace graph.
.git
.turbo
.idea
.vscode
.DS_Store
**/node_modules
**/dist
**/.next
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
*.log
logs/
docker/
docs/
prompts/
.agents/
# Environment files never enter an image; containers get them via env_file.
apps/api/env/
# Unrelated application source is not part of the API build.
apps/web/**
!apps/web/package.json
apps/admin/**
!apps/admin/package.json
