{
  "name": "@neo-bank/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    },
    "#config/*": {
      "types": "./src/shared/config/*",
      "default": "./dist/shared/config/*"
    },
    "#enums/*": {
      "types": "./src/shared/enums/*",
      "default": "./dist/shared/enums/*"
    },
    "#errors/*": {
      "types": "./src/shared/errors/*",
      "default": "./dist/shared/errors/*"
    },
    "#http/*": {
      "types": "./src/shared/http/*",
      "default": "./dist/shared/http/*"
    }
  },
  "scripts": {
    "dev": "node --env-file=env/.env.development node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=env/.env.test node_modules/vitest/vitest.mjs run --config test/vitest-e2e.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/terminus": "12.1.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "fastify": "5.12.7",
    "pino-pretty": "^13.2.0",
    "supertest": "7.1.4",
    "vitest": "5.0.5"
  }
}
