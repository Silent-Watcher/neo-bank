# Runtime environment: development | production | test
APP_ENV=
# Server bind address: a hostname, IPv4, or IPv6 address.
HOST=
PORT=

# Comma-separated list of allowed CORS origins. Each entry must be a full
# origin (scheme://host[:port], no path), for example:
#   http://localhost:3000,https://app.example.com
# Whitespace and empty entries are ignored. When unset or empty, CORS stays
# disabled; required when APP_ENV=production.
CORS_ORIGIN=

# Whether Fastify should trust proxy-provided headers to determine the client
# IP and protocol. Only the exact strings "true" and "false" are accepted;
# defaults to false.
TRUST_PROXY=

# Maximum request body size in bytes; defaults to 1048576 (1 MiB).
BODY_LIMIT=

# Application log level; one of: fatal, error, warn, info, debug, trace.
# Defaults to info.
LOG_LEVEL=
