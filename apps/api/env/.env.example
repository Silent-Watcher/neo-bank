# Runtime environment: development | production | test
APP_ENV=
# Server bind address: a hostname, IPv4, or IPv6 address.
HOST=
PORT=

# Comma-separated list of allowed CORS origins. Each entry must be a full
# origin (scheme://host[:port], no path), for example:
#   http://localhost:3000,https://app.example.com
# Whitespace and empty entries are ignored. When unset or empty, CORS stays
# disabled; required when APP_ENV=production.
CORS_ORIGIN=

# Whether Fastify should trust proxy-provided headers to determine the client
# IP and protocol. Only the exact strings "true" and "false" are accepted;
# defaults to false.
TRUST_PROXY=

# Maximum request body size in bytes; defaults to 1048576 (1 MiB).
BODY_LIMIT=

# Host-accessible Redis Insight URL (ADR-020). Optional; set it only where
# Redis Insight is actually exposed — the development Compose stack injects
# it (http://localhost:<REDIS_INSIGHT_PORT>), so the API startup log prints
# the address only in that environment. Leave unset everywhere else (local
# non-Docker development, test, production): no URL is logged when missing.
REDIS_INSIGHT_URL=

# MockServer addresses (ADR-024). Optional; set them only where MockServer
# is actually running — the development Compose stack injects both, so the
# API startup log prints the addresses only in that environment. Leave unset
# everywhere else (local non-Docker development, test, production): no
# address is logged when missing. MOCKSERVER_HOST_URL is the address
# developers use from the host machine; MOCKSERVER_DOCKER_URL is the address
# other containers use on the Compose network (http://<service-name>:1080).
MOCKSERVER_HOST_URL=
MOCKSERVER_DOCKER_URL=

# Application log level; one of: fatal, error, warn, info, debug, trace.
# Defaults to info.
LOG_LEVEL=

# Explicit pretty-printing override; only the exact strings "true" and
# "false" are accepted. Unset keeps the default behavior (pretty in
# development, structured JSON everywhere else). Set "false" where a
# containerized API must emit structured JSON for centralized log
# collection — the development Compose stack does exactly that — or "true"
# to force pretty output anywhere.
LOG_PRETTY=

# Redis connection URL: redis://host:port or rediss://host:port (TLS).
# Required. The Redis server itself may be unreachable at startup — the
# application still boots and /health reports a degraded (HTTP 200) status —
# but the URL must be structurally valid.
REDIS_URL=
# Redis credentials (ACL username and password). Required variables; set
# them to an empty value when the server requires no authentication.
REDIS_USERNAME=
REDIS_PASSWORD=
# Logical Redis database index (0-15); defaults to the server default (0).
REDIS_DB=
# Force TLS even for a plain redis:// URL; only "true" and "false" are
# accepted. A rediss:// URL always uses TLS regardless. Defaults to false.
REDIS_TLS=
# Connection establishment timeout in milliseconds. Defaults to 10000.
REDIS_CONNECT_TIMEOUT_MS=
# Per-command timeout in milliseconds (also bounds health-check PINGs).
# Defaults to 5000.
REDIS_COMMAND_TIMEOUT_MS=
# Maximum retry attempts per command before it fails; defaults to 3.
REDIS_MAX_RETRIES_PER_REQUEST=
# Time to wait for a graceful QUIT during shutdown, in milliseconds, before
# the connection is force-closed. Defaults to 2000.
REDIS_SHUTDOWN_TIMEOUT_MS=

# PostgreSQL connection URL (ADR-027): postgres://host:port/db or
# postgresql://user:password@host:port/db. Required. The database server may
# be unreachable at startup — the application still boots and /health reports
# a degraded (HTTP 200) status — but the URL must be structurally valid.
# Example format (never commit real credentials):
#   postgresql://neo_bank:secret@127.0.0.1:5432/neo_bank
DATABASE_URL=

# Global HTTP rate limiting (two named policies: short and long).
# Limits are request counts; TTL values are seconds/minutes and are converted
# to milliseconds (the @nestjs/throttler unit) by the throttler module factory.
# Defaults: short 10 req/1s, long 100 req/1m.
RATE_LIMIT_SHORT_LIMIT=10
RATE_LIMIT_SHORT_TTL_SECONDS=1
RATE_LIMIT_LONG_LIMIT=100
RATE_LIMIT_LONG_TTL_MINUTES=1

# Enrollments: maximum failed OTP verification attempts per 120-second validity
# window. When exceeded, the active OTP is invalidated and the client must wait
# for the lockout window to expire before requesting a new one.
ENROLLMENTS_MAX_VERIFY_ATTEMPTS=5

# Enrollments: lockout window in seconds after max verification attempts are
# exceeded. During this window, both OTP issuance and verification are rejected
# for the phone number. Independent of the 120-second OTP TTL. Default: 900 (15 minutes).
ENROLLMENTS_LOCKOUT_TTL_SECONDS=900

# Enrollments: dedicated HMAC-SHA-256 key for OTP digest storage (ADR-018).
# Required, no default: startup fails when missing or malformed. Must be exactly
# 64 hexadecimal characters (32 decoded bytes). Generate per environment with:
#   openssl rand -hex 32
# Must be identical across all API instances that verify the same OTPs, must
# never be logged, and must never be stored in Redis.
ENROLLMENTS_OTP_HMAC_SECRET=

# Memory-based load shedding (ADR-026). While the process RSS stays above
# MAX_RSS_MB, new non-exempt requests are rejected with 503 + Retry-After and
# the readiness endpoint reports down. Recovery requires RSS below
# RECOVERY_RSS_MB for STABLE_SAMPLES consecutive samples (hysteresis; must be
# lower than MAX_RSS_MB — validated at startup). SAMPLE_INTERVAL_MS is both
# the sampling cadence and the Retry-After value.
# MEMORY_PROTECTION_MAX_RSS_MB must match the deployment's real memory limit.
MEMORY_PROTECTION_ENABLED=true
MEMORY_PROTECTION_MAX_RSS_MB=1024
MEMORY_PROTECTION_RECOVERY_RSS_MB=768
MEMORY_PROTECTION_SAMPLE_INTERVAL_MS=5000
MEMORY_PROTECTION_STABLE_SAMPLES=3
