# Values for Compose variable interpolation (ports, credentials, service
# configuration). Copy to docker/env/.env.docker.dev (development) or
# docker/env/.env.docker.prod (production) and adjust; pass it explicitly:
#   docker compose --env-file docker/env/.env.docker.dev -f docker/compose.yml up --build
#
# This file configures Compose itself. Application-internal configuration
# (env vars injected into containers) comes from the apps' env files via
# `env_file` — see docs/docker.md.

# Host ports for the applications.
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=5173

# Host ports for PostgreSQL and Redis (development tools only; production
# does not expose them).
POSTGRES_PORT=5432
REDIS_PORT=6379

# Host port for Redis Insight, bundled in the dev stack's redis/redis-stack
# image (ADR-020). Development only; production does not expose it.
REDIS_INSIGHT_PORT=8001

# Host port for MockServer, the development-only HTTP mock service used to
# simulate downstream service failures when testing resilience patterns
# (ADR-024). Development only; production has no MockServer service.
MOCKSERVER_PORT=1080

# PostgreSQL credentials (used by both environments).
POSTGRES_USER=neo_bank
POSTGRES_DB=neo_bank
# Required: no default is provided for the database password. Compose
# interpolates this value into the API's DATABASE_URL, which cannot
# percent-encode it — the value must not contain unencoded `@ : / ? # %`
# characters (use hex output, e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Redis password — required in both environments: the Compose Redis always
# runs with requirepass, and the API receives the same value automatically.
REDIS_PASSWORD=
