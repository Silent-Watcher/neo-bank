# Values for Compose variable interpolation of the monitoring stack
# (compose.monitoring.yml). Copy to .env.monitoring and adjust:
#   cp .env.monitoring.example .env.monitoring
#   docker compose --env-file .env.monitoring -f compose.monitoring.yml up -d
# or use the repository scripts: pnpm docker:monitoring / pnpm docker:monitoring:down

# Host port for the Grafana web UI — the only monitoring port on the host.
# Loki and Alloy are reachable only inside the monitoring network.
# 3002 avoids the API (3001) and the web app (3000).
GRAFANA_PORT=3002

# Grafana admin credentials. The password is required: no default exists,
# the stack refuses to start without one. Local development only — never
# reuse a real credential here.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Numeric GID of the group that owns the Docker socket on the host — Alloy
# needs it (as a supplemental group) to read /var/run/docker.sock without
# running as root. Find it with:
#   stat -c %g /var/run/docker.sock
# (on most hosts this is the `docker` group; a common value is 999)
DOCKER_GID=
